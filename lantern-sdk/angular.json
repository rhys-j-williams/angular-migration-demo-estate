{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "lantern-sdk": {
      "projectType": "library",
      "root": "projects/lantern-sdk",
      "sourceRoot": "projects/lantern-sdk/src",
      "prefix": "mtb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/lantern-sdk/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/lantern-sdk/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/lantern-sdk/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/lantern-sdk/src/test.ts",
            "tsConfig": "projects/lantern-sdk/tsconfig.spec.json",
            "karmaConfig": "projects/lantern-sdk/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "projects/lantern-sdk/tsconfig.lib.json",
              "projects/lantern-sdk/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "lantern-sdk"
}
