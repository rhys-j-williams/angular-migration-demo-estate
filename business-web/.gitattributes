# Normalise everything to LF in the repository. CONTRIBUTING.md, "Line endings".
* text=auto eol=lf

*.ts   text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
Jenkinsfile text eol=lf

*.png  binary
*.ico  binary
*.woff2 binary

# NACHA sample files are byte-exact, CRLF is part of the format. Do not touch. MBZ-1104
src/assets/nacha/*.ach -text
