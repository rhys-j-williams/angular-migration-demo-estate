# Meridian Online registry configuration.
#
# The @meridian scope resolves against the estate Verdaccio locally (mock-external/estate-up.sh
# brings it up on 4873). On the nodejs16-rhel8 Jenkins agents the Vault agent writes its own
# .npmrc over this one with the Artifactory virtual repo and a short lived token, so nothing in
# here is ever used for a pipeline run.
@meridian:registry=http://localhost:4873
# @meridian:registry=https://artifactory.meridian.internal/artifactory/api/npm/npm-meridian-virtual/
# //artifactory.meridian.internal/artifactory/api/npm/npm-meridian-virtual/:_authToken=${ARTIFACTORY_NPM_TOKEN}

# 2021-03: the Artifactory cert chain was reissued off the new internal CA and the agents did not
# trust it for about a week. Left in, commented, in case it happens again (TOOL-877).
# strict-ssl=false

# 2020-11: Artifactory started rejecting anonymous reads of the virtual repo. Fixed on their side
# in TOOL-702 but keep this handy.
# always-auth=true

# angular-oauth2-oidc 14 declares an rxjs ^6 || ^7 peer that npm 8 still trips over when
# flex-layout is in the tree, and @angular/flex-layout beta.41 declares its Angular peer as 14.0
# exactly. MOL-3611. Do not pass this on the command line, the Jenkinsfile does not.
legacy-peer-deps=true

save-exact=true
puppeteer_skip_download=true
