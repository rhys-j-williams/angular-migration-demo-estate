{
  "environment": "uat",
  "apiBaseUrl": "https://online-uat.meridiantrust.example/api/v1",
  "keystone": {
    "issuer": "https://login-uat.meridiantrust.example/oauth2/v1",
    "clientId": "meridian-online-web",
    "scope": "openid profile email offline_access accounts.read payments.write",
    "redirectUri": "https://online-uat.meridiantrust.example/auth/callback",
    "silentRefreshRedirectUri": "https://online-uat.meridiantrust.example/silent-refresh.html",
    "postLogoutRedirectUri": "https://online-uat.meridiantrust.example/",
    "stepUpAcr": "urn:meridian:keystone:loa2",
    "requireHttps": true
  },
  "semaphore": { "baseUrl": "https://semaphore-uat.meridiantrust.example/api/v1", "environment": "uat", "refreshSeconds": 120 },
  "lantern": { "writeKey": "CHANGEME-lantern-write-key-uat", "scriptUrl": "https://static.meridiantrust.example/lantern/v4/lantern.min.js", "debug": false, "disabled": false },
  "telemetry": { "splunkHecUrl": "https://hec-uat.meridiantrust.example/services/collector/event", "splunkToken": "CHANGEME-splunk-hec-token", "index": "digital_retail_web_uat", "sampleRate": 1 },
  "session": { "idleWarningSeconds": 480, "idleLogoutSeconds": 600, "warningCountdownSeconds": 120 },
  "transfers": { "mfaStepUpThresholdMinor": 250000, "mfaMaxAgeSeconds": 600, "dailyExternalLimitMinor": 1000000, "cutoffLocalTime": "17:00", "cutoffTimeZone": "America/New_York" },
  "features": { "paylinkEnabled": true, "rewardsEnabled": true, "secureMessagesEnabled": true, "onboardingEnabled": false },
  "support": { "phone": "1-800-555-0142", "lostCardPhone": "1-800-555-0199", "hoursCopy": "Monday to Friday 7am to 10pm ET, weekends 8am to 6pm ET" }
}
