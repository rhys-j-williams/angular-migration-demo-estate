{
  "environment": "local",
  "apiBaseUrl": "/api/v1",
  "keystone": {
    "issuer": "http://localhost:4400/oauth2/v1",
    "clientId": "meridian-online-web",
    "scope": "openid profile email offline_access accounts.read payments.write",
    "redirectUri": "http://localhost:4200/auth/callback",
    "silentRefreshRedirectUri": "http://localhost:4200/silent-refresh.html",
    "postLogoutRedirectUri": "http://localhost:4200/",
    "stepUpAcr": "urn:meridian:keystone:loa2",
    "requireHttps": false
  },
  "semaphore": {
    "baseUrl": "/flags",
    "environment": "local",
    "refreshSeconds": 300
  },
  "lantern": {
    "writeKey": "CHANGEME-lantern-write-key-local",
    "scriptUrl": "http://localhost:4607/v4/lantern.min.js",
    "collectorUrl": "http://localhost:4607",
    "debug": true,
    "disabled": false
  },
  "telemetry": {
    "splunkHecUrl": "/telemetry/event",
    "splunkToken": "CHANGEME-splunk-hec-token",
    "index": "digital_retail_web",
    "sampleRate": 1
  },
  "session": {
    "idleWarningSeconds": 480,
    "idleLogoutSeconds": 600,
    "warningCountdownSeconds": 120
  },
  "transfers": {
    "mfaStepUpThresholdMinor": 250000,
    "mfaMaxAgeSeconds": 600,
    "dailyExternalLimitMinor": 1000000,
    "cutoffLocalTime": "17:00",
    "cutoffTimeZone": "America/New_York"
  },
  "features": {
    "paylinkEnabled": true,
    "rewardsEnabled": true,
    "secureMessagesEnabled": true,
    "onboardingEnabled": true
  },
  "support": {
    "phone": "1-800-555-0142",
    "lostCardPhone": "1-800-555-0199",
    "hoursCopy": "Monday to Friday 7am to 10pm ET, weekends 8am to 6pm ET"
  }
}
