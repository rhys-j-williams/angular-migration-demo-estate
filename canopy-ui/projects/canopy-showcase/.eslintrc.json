{
  "extends": "../../.eslintrc.json",
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["projects/canopy-showcase/tsconfig.app.json", "projects/canopy-showcase/tsconfig.spec.json"],
        "createDefaultProgram": true
      },
      "rules": {
        "@angular-eslint/directive-selector": ["error", { "type": "attribute", "prefix": "cs", "style": "camelCase" }],
        "@angular-eslint/component-selector": ["error", { "type": "element", "prefix": "cs", "style": "kebab-case" }]
      }
    },
    {
      "files": ["*.html"],
      "rules": {}
    }
  ]
}
