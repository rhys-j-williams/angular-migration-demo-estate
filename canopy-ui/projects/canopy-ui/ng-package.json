{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/canopy-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "input": "./src/lib/tokens", "glob": "**/*.scss", "output": "./tokens" },
    { "input": "./src/lib/themes", "glob": "**/*.scss", "output": "./themes" },
    { "input": "./src/lib/icons", "glob": "canopy-sprite.svg", "output": "./icons" },
    "./schematics/collection.json",
    "./schematics/ng-add/schema.json",
    "./schematics/ng-add/index.js",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "allowedNonPeerDependencies": ["tslib"]
}
