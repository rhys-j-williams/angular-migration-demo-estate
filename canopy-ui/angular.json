{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "canopy-ui": {
      "projectType": "library",
      "root": "projects/canopy-ui",
      "sourceRoot": "projects/canopy-ui/src",
      "prefix": "cn",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/canopy-ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/canopy-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/canopy-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/canopy-ui/src/test.ts",
            "tsConfig": "projects/canopy-ui/tsconfig.spec.json",
            "karmaConfig": "projects/canopy-ui/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/canopy-ui/**/*.ts",
              "projects/canopy-ui/**/*.html"
            ]
          }
        }
      }
    },
    "canopy-showcase": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/canopy-showcase",
      "sourceRoot": "projects/canopy-showcase/src",
      "prefix": "cs",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/canopy-showcase",
            "index": "projects/canopy-showcase/src/index.html",
            "main": "projects/canopy-showcase/src/main.ts",
            "polyfills": "projects/canopy-showcase/src/polyfills.ts",
            "tsConfig": "projects/canopy-showcase/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/canopy-showcase/src/favicon.ico",
              "projects/canopy-showcase/src/assets",
              {
                "glob": "canopy-sprite.svg",
                "input": "projects/canopy-ui/src/lib/icons",
                "output": "/assets/canopy"
              }
            ],
            "styles": [
              "projects/canopy-showcase/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "moment",
              "@meridian/domain-fixtures"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/canopy-showcase/src/environments/environment.ts",
                  "with": "projects/canopy-showcase/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "canopy-showcase:build:production"
            },
            "development": {
              "browserTarget": "canopy-showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "canopy-showcase:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/canopy-showcase/src/test.ts",
            "polyfills": "projects/canopy-showcase/src/polyfills.ts",
            "tsConfig": "projects/canopy-showcase/tsconfig.spec.json",
            "karmaConfig": "projects/canopy-showcase/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/canopy-showcase/src/favicon.ico",
              "projects/canopy-showcase/src/assets",
              {
                "glob": "canopy-sprite.svg",
                "input": "projects/canopy-ui/src/lib/icons",
                "output": "/assets/canopy"
              }
            ],
            "styles": [
              "projects/canopy-showcase/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/canopy-showcase/**/*.ts",
              "projects/canopy-showcase/**/*.html"
            ]
          }
        }
      }
    }
  }
}
