# Canopy registry configuration. Reviewed by GIS as part of DEPENDENCY_POLICY.md.
#
# Locally the estate runs Verdaccio on 4873 (mock-external/estate-up.sh). On the Jenkins agents the
# same scope is served by the internal Artifactory virtual repository; the agent image drops in its
# own .npmrc via the Vault agent so this file is never edited for a pipeline run.
@meridian:registry=http://localhost:4873
# @meridian:registry=https://artifactory.meridian.internal/artifactory/api/npm/npm-meridian-virtual/
# //artifactory.meridian.internal/artifactory/api/npm/npm-meridian-virtual/:_authToken=${ARTIFACTORY_NPM_TOKEN}

# ng-packagr 14 and angular-eslint 14 disagree about the eslint peer range. TOOL-1420.
legacy-peer-deps=true

# Karma uses the Chrome baked into the nodejs16-rhel8 agent image (CHROME_BIN), so the puppeteer
# download is skipped. Developers on laptops set CHROME_BIN too; see README "Running the tests".
puppeteer_skip_download=true
save-exact=true
