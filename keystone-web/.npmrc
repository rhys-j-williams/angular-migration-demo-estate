# Internal scope comes from Artifactory in the bank; locally the estate Verdaccio stands in for it.
@meridian:registry=http://localhost:4873
# Canopy 3.6.x still declares Angular 14 peers. Keystone went to 15 ahead of the design system
# (KEY-2144) and we have been carrying this flag since. Remove when canopy-ui 4.x is adopted.
legacy-peer-deps=true
save-exact=true
fund=false
audit=false
puppeteer_skip_download=true
