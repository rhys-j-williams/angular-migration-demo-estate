{
  "name": "@meridian/keystone-web",
  "version": "2.3.0",
  "description": "Keystone login, MFA, device trust and step-up front end. Relying party UI for the Keystone IdP. Served at login.meridiantrust.example.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "14.17.0",
    "npm": "6.14.15"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4202",
    "start:mock-idp": "KEYSTONE_IDP_URL=http://localhost:4400 ng serve --port 4202 --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --configuration production --stats-json",
    "test": "ng test --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "audit:ci": "npm audit --audit-level=high --omit=dev || true"
  },
  "dependencies": {
    "@angular/animations": "12.2.16",
    "@angular/cdk": "12.2.13",
    "@angular/common": "12.2.16",
    "@angular/compiler": "12.2.16",
    "@angular/core": "12.2.16",
    "@angular/forms": "12.2.16",
    "@angular/material": "12.2.13",
    "@angular/platform-browser": "12.2.16",
    "@angular/platform-browser-dynamic": "12.2.16",
    "@angular/router": "12.2.16",
    "angular-oauth2-oidc": "12.1.0",
    "rxjs": "6.6.7",
    "tslib": "2.3.0",
    "zone.js": "0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "12.2.16",
    "@angular-eslint/builder": "12.7.0",
    "@angular-eslint/eslint-plugin": "12.7.0",
    "@angular-eslint/eslint-plugin-template": "12.7.0",
    "@angular-eslint/schematics": "12.7.0",
    "@angular-eslint/template-parser": "12.7.0",
    "@angular/cli": "12.2.16",
    "@angular/compiler-cli": "12.2.16",
    "@meridian/domain-fixtures": "1.6.0",
    "@types/jasmine": "3.8.0",
    "@types/node": "14.17.0",
    "@typescript-eslint/eslint-plugin": "4.33.0",
    "@typescript-eslint/parser": "4.33.0",
    "eslint": "7.32.0",
    "jasmine-core": "3.8.0",
    "karma": "6.3.4",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "typescript": "4.3.5"
  }
}
