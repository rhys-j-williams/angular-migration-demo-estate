{
  "name": "@meridian/keystone-web",
  "version": "4.6.2",
  "description": "Keystone login, MFA, device trust and step-up front end. Relying party UI for the Keystone IdP. Served at login.meridiantrust.example.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4202",
    "start:mock-idp": "KEYSTONE_IDP_URL=http://localhost:4400 ng serve --port 4202 --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --configuration production --stats-json",
    "test": "ng test --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "csp:check": "node scripts/check-csp.js",
    "audit:ci": "npm audit --audit-level=high --omit=dev || true"
  },
  "dependencies": {
    "@angular/animations": "14.2.12",
    "@angular/cdk": "14.2.7",
    "@angular/common": "14.2.12",
    "@angular/compiler": "14.2.12",
    "@angular/core": "14.2.12",
    "@angular/forms": "14.2.12",
    "@angular/material": "14.2.7",
    "@angular/platform-browser": "14.2.12",
    "@angular/platform-browser-dynamic": "14.2.12",
    "@angular/router": "14.2.12",
    "@meridian/canopy-ui": "3.6.1",
    "angular-oauth2-oidc": "14.0.1",
    "rxjs": "7.5.7",
    "tslib": "2.4.1",
    "zone.js": "0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "14.2.12",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "14.2.12",
    "@angular/compiler-cli": "14.2.12",
    "@meridian/domain-fixtures": "1.6.0",
    "@types/jasmine": "4.3.1",
    "@types/node": "16.18.11",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "8.28.0",
    "jasmine-core": "4.5.0",
    "karma": "6.4.1",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "typescript": "4.7.4"
  }
}
