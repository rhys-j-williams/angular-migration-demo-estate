{
  "name": "@meridian/keystone-web",
  "version": "4.8.0",
  "description": "Keystone login, MFA, device trust and step-up front end. Relying party UI for the Keystone IdP. Served at login.meridiantrust.example.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4202",
    "start:mock-idp": "KEYSTONE_IDP_URL=http://localhost:4400 ng serve --port 4202 --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --configuration production --stats-json",
    "test": "ng test --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "audit:ci": "npm audit --audit-level=high --omit=dev || true"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "15.2.9",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/material": "15.2.9",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "@meridian/canopy-ui": "3.6.1",
    "angular-oauth2-oidc": "15.0.1",
    "rxjs": "7.8.0",
    "tslib": "2.5.0",
    "zone.js": "0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "15.2.10",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "15.2.10",
    "@angular/compiler-cli": "15.2.10",
    "@meridian/domain-fixtures": "1.6.0",
    "@types/jasmine": "4.3.1",
    "@types/node": "16.18.11",
    "@typescript-eslint/eslint-plugin": "5.48.2",
    "@typescript-eslint/parser": "5.48.2",
    "eslint": "8.33.0",
    "jasmine-core": "4.5.0",
    "karma": "6.4.1",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "typescript": "4.9.5"
  }
}
